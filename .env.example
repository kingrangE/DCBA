# docker compose up --build는 이 파일 없이도 아래 기본값으로 실행됩니다.
# LLM 워커를 사용할 때만 이 파일을 .env로 복사하고 API 설정을 입력하세요.
# 모니터링은 docker compose --profile monitoring up -d 로 별도 실행합니다.
# LLM 워커를 실행하려면 NVIDIA 키와 계정에서 사용 가능한 모델 ID가 필요합니다.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AUTO_GENERATION_INTERVAL_SECONDS=60
# 관리자 화면을 사용할 기존 계정의 숫자 ID입니다. 0이면 관리자 권한을 부여하지 않습니다.
DCBA_ADMIN_USER_ID=0
# 임시 중복검사 비활성화. 다시 켤 때 true로 변경합니다.
DEDUPLICATION_ENABLED=true
OPENAI_API_KEY=

MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=
MARIADB_ROOT_PASSWORD=

# 내부 생성 API 또는 AI 복습 피드백에 사용합니다.
LLM_API_KEY=
REVIEW_FEEDBACK_ENABLED=false
REVIEW_LLM_BASE_URL=http://llm-server:8000

# React Web에 접근하기 위한 외부 포트
FRONTEND_PORT=

# Java REST API에 접근하기 위한 외부 포트
DCBA_SERVER_PORT=
# MariaDB 로컬 관리 포트 (127.0.0.1에만 바인딩)
EXTERNAL_MARIADB_PORT=
