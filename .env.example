# docker compose up --build는 이 파일 없이도 아래 기본값으로 실행됩니다.
# LLM 워커를 사용할 때만 이 파일을 .env로 복사하고 API 설정을 입력하세요.
# 모니터링은 docker compose --profile monitoring up -d 로 별도 실행합니다.
# Kanana 모델은 첫 문제 생성 시 Hugging Face에서 내려받습니다.
KANANA_MODEL_NAME=
KANANA_DEVICE_MAP=
KANANA_MAX_NEW_TOKENS=
KANANA_TEMPERATURE=
KANANA_TOP_P=
HF_HOME=
# 임시 중복검사 비활성화. 다시 켤 때 true로 변경합니다.
DEDUPLICATION_ENABLED=
OPENAI_API_KEY=

MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=
MARIADB_ROOT_PASSWORD=

LLM_SERVER_PORT=

# React Web에 접근하기 위한 외부 포트
FRONTEND_PORT=

# Java REST API에 접근하기 위한 외부 포트
DCBA_SERVER_PORT=
# Redis에 접근하기 위한 외부 포트
EXTERNAL_REDIS_PORT=
# MariaDB에 접근하기 위한 외부 포트
EXTERNAL_MARIADB_PORT=
